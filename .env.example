# Copy to .env in the repository root. Existing exported variables take priority.
RESONANCE_DATA_DIR=data
RESONANCE_DATABASE_PATH=outputs/resonance.sqlite3
RESONANCE_ARTIFACT_DIR=outputs/artifacts
RESONANCE_UPLOAD_DIR=outputs/uploads
RESONANCE_HOST=127.0.0.1
RESONANCE_PORT=8000
# make run generates a private local token if none is supplied.
# Production review requires a random token of at least 24 characters.
# RESONANCE_ADMIN_TOKEN=
# Set after model download and verification:
# RESONANCE_ALIKED_MODEL=models/aliked-n16rot-top1k-640.onnx
# RESONANCE_LIGHTGLUE_MODEL=models/aliked_lightglue.onnx
# RESONANCE_VEHICLE_MODEL=models/object_detection_yolox_2022nov.onnx
# Actual AWS/COOL provenance, configured in the deferred deployment phase:
# RESONANCE_INSTANCE_TYPE=
# RESONANCE_AMI_ID=
# RESONANCE_AWS_REGION=us-east-1
# RESONANCE_SNS_TOPIC_ARN=
